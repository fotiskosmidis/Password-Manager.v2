{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "password-managerv2",
  "version": "0.1.0",
  "identifier": "com.fotis.password-managerv2",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "password-managerv2",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/*"],
    "linux": {
      "appimage": {
        "files": {
          "usr/bin/libpassword_manager_backend.so": "../build/libpassword_manager_backend.so"
        }
      },
      "deb": {
        "files": {
          "/usr/bin/libpassword_manager_backend.so": "../build/libpassword_manager_backend.so"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
